<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- LiveKit brings these along for screen sharing, which this app does not do. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" tools:node="remove" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Nothing of this app is backed up or moved to a new phone: the phone's secret is tied to this phone's
         keystore, so a restored copy could not be opened anyway. A new phone is paired again. -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MenkerudHome">

        <!-- Push registration through Firebase's installation id, not the deprecated token (push/FirebasePushAddress.kt). -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The one screen for a call. Android opens it over the lock screen for the ringing notification. It lives
             in a task of its own, so that after a call the phone is back where it was. It turns with the phone only
             while a call is on (set in code); a turn does not restart it. -->
        <activity
            android:name=".ui.CallActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity="com.noobventure.menkerud.call"
            android:turnScreenOn="true"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            tools:targetApi="o_mr1" />

        <!-- The notification buttons that need no screen. -->
        <receiver
            android:name=".call.CallActionReceiver"
            android:exported="false" />

        <!-- Keeps a call alive when the parent leaves the call screen. -->
        <service
            android:name=".call.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!-- Where pushes arrive. -->
        <service
            android:name=".push.MenkerudMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name="io.livekit.android.room.track.screencapture.ScreenCaptureService"
            tools:node="remove" />
    </application>
</manifest>
