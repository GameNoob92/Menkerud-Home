# Release signing for Menkerud Home (the parent app).
#
# The keystore is the app's identity on the two phones: an installed app can only be replaced by a build signed
# with the same key. Lose it, and the app has to be uninstalled first - which unpairs the phone. Keep the keystore
# OUTSIDE this repo, and back it up.
#
# 1. Make the keystore once (it asks for a password - choose one and keep it):
#
#      "C:\Program Files\Android\Android Studio\jbr\bin\keytool.exe" -genkeypair -v ^
#        -keystore <a folder outside the repo>\menkerud-release.jks -alias menkerud -keyalg RSA -keysize 2048 -validity 10000
#
# 2. Copy this file to "keystore.properties" (same folder) and fill in the values below.
#    keystore.properties and *.jks are git-ignored and must never be committed.
#
# 3. Build: gradlew :app:assembleRelease  ->  app/build/outputs/apk/release/app-release.apk
#
# storeFile is an absolute path (forward slashes are fine), or a path relative to this folder. Instead of this file
# the build also reads the environment variables MENKERUD_STORE_FILE, MENKERUD_STORE_PASSWORD, MENKERUD_KEY_ALIAS
# and MENKERUD_KEY_PASSWORD.

storeFile=C:/somewhere/outside/the/repo/menkerud-release.jks
storePassword=CHANGE_ME
keyAlias=menkerud
keyPassword=CHANGE_ME
