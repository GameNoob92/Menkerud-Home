# Menkerud Home call backend — runs on the Ubuntu touchscreen PC as a systemd service (see ../DEPLOYMENT.md).
# Copy to .env (gitignored) and fill in. LIVEKIT_API_KEY/SECRET must match the pair in LiveKit's config on Unraid.
PORT=3000
CALL_PUBLIC_URL=https://call.noobventure.com   # public answer-link base (SWAG on Unraid proxies this -> this PC:3000)
CALL_RING_TIMEOUT_SECONDS=60
CALL_TOKEN_TTL_SECONDS=600

# LiveKit (the server runs on Unraid)
LIVEKIT_URL=wss://rtc.noobventure.com          # what browsers connect to (through SWAG)
LIVEKIT_API_URL=http://192.168.68.74:7880      # LiveKit admin API on Unraid over the LAN (room cleanup)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Discord (reuse GameNoobBot's token). User IDs are public, not secret.
DISCORD_BOT_TOKEN=
DISCORD_MOR_USER_ID=802608765533945887
DISCORD_FAR_USER_ID=547117382804570112

# Shared secret the kiosk sends as X-Device-Key so only it can start calls. Put the same value in the kiosk's
# config.js (call.deviceKey). Recommended, since the backend port is reachable on the LAN. Empty = open.
DEVICE_KEY=

# Set to 1 only while testing to expose /dev/pair (two tokens for one room, no Discord).
DEV=0
