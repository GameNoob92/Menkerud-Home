# Menkerud Home call-backend — runs as a Docker container on Unraid (see ../DEPLOYMENT.md).
# Copy to .env (gitignored, next to docker-compose.yml) and fill in. LIVEKIT_API_KEY/SECRET must match
# the pair in LiveKit's config at /mnt/user/appdata/LiveKit/config.yaml.
PORT=3000                                      # container-internal port (compose publishes it on host 3008)
CALL_PUBLIC_URL=https://call.noobventure.com   # public answer-link base (SWAG -> the menkerud-callapi container)
CALL_RING_TIMEOUT_SECONDS=60
CALL_TOKEN_TTL_SECONDS=600

# LiveKit (the server runs on Unraid; config at /mnt/user/appdata/LiveKit/config.yaml)
LIVEKIT_URL=wss://rtc.noobventure.com          # what browsers connect to (through SWAG); the backend returns this to clients
# LIVEKIT_API_URL is the admin API used for best-effort room cleanup. Leave it unset and the backend derives
# https://rtc.noobventure.com from LIVEKIT_URL (through SWAG, auth-protected). Only set a direct LAN URL such as
# http://192.168.68.74:7880 if LiveKit's HTTP port is reachable on your LAN and you prefer to bypass SWAG.
#LIVEKIT_API_URL=
LIVEKIT_API_KEY=                               # must equal the key in /mnt/user/appdata/LiveKit/config.yaml (keys:)
LIVEKIT_API_SECRET=                            # must equal the matching secret in that file

# Discord (reuse GameNoobBot's token). User IDs are public, not secret.
DISCORD_BOT_TOKEN=
DISCORD_MOR_USER_ID=802608765533945887
DISCORD_FAR_USER_ID=547117382804570112

# Shared secret the kiosk sends as X-Device-Key so only it can start calls. Put the same value in the kiosk's
# config.js (call.deviceKey). Recommended, since the backend port is reachable on the LAN. Empty = open.
DEVICE_KEY=

# Set to 1 only while testing to expose /dev/pair (two tokens for one room, no Discord).
DEV=0
