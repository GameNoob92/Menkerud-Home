# Menkerud Home call-backend — runs as a Docker container on Unraid (see ../DEPLOYMENT.md).
# Copy to .env (gitignored, next to docker-compose.yml) and fill in. LIVEKIT_API_KEY/SECRET must match
# the pair in LiveKit's config at /mnt/user/appdata/LiveKit/config.yaml.
PORT=3000                                      # container-internal port (compose publishes it on host 3008)
CALL_PUBLIC_URL=https://call.noobventure.com   # public answer-link base (SWAG -> the menkerud-callapi container)
CALL_RING_TIMEOUT_SECONDS=60
CALL_TOKEN_TTL_SECONDS=600

# LiveKit (the server runs on Unraid; config at /mnt/user/appdata/LiveKit/config.yaml)
LIVEKIT_URL=wss://rtc.noobventure.com          # what browsers connect to (through SWAG); the backend returns this to clients
# LIVEKIT_API_URL is the admin API used for best-effort room cleanup. Leave it unset and the backend derives
# https://rtc.noobventure.com from LIVEKIT_URL (through SWAG, auth-protected). Only set a direct LAN URL such as
# http://192.168.68.74:7880 if LiveKit's HTTP port is reachable on your LAN and you prefer to bypass SWAG.
#LIVEKIT_API_URL=
LIVEKIT_API_KEY=                               # must equal the key in /mnt/user/appdata/LiveKit/config.yaml (keys:)
LIVEKIT_API_SECRET=                            # must equal the matching secret in that file

# Discord (reuse GameNoobBot's token). User IDs are public, not secret.
DISCORD_BOT_TOKEN=
DISCORD_MOR_USER_ID=802608765533945887
DISCORD_FAR_USER_ID=547117382804570112

# Shared secret the kiosk sends as X-Device-Key. Put the same value in the kiosk's config.js (call.deviceKey).
# REQUIRED for the parent app: without it the kiosk's event stream and its answer route stay closed (nobody may sit in
# for the screen at home), so the app cannot ring home. Empty still leaves «start a call» and the messages routes
# open to anyone who can reach this service, as before – so set it.
DEVICE_KEY=

# --- Parent app ---
# The local pairing page (http://192.168.68.74:3012) is published on the host's LAN address only and must never be proxied by SWAG.
ADMIN_PORT=3001                                # container-internal port of the pairing page (compose publishes it on host 3012)
ADMIN_USER=                                    # user name the pairing page asks for; empty = any user name goes with the password
ADMIN_PASSWORD=                                # what the pairing page asks for; empty = the page is switched off
DATA_DIR=/app/data                             # paired phones; compose mounts it from appdata, outside this synced folder
PUSH_TRANSPORT=                                # empty = fcm when the Firebase key file exists, otherwise none; "file" is for the dev copy
# Path to the Firebase service-account key; empty = <DATA_DIR>/fcm-service-account.json. In production:
# /app/secrets/fcm-service-account.json - compose mounts the secrets/ folder beside this file read-only, and the
# folder (never committed) comes over with the sync like .env does.
FCM_SERVICE_ACCOUNT=
CALL_MAX_SECONDS=7200                          # a call is ended after this many seconds whatever happens

# Set to 1 only while testing to expose /dev/pair (two tokens for one room, no Discord).
DEV=0
