# The DEV COPY of the call backend: its own ports, its own data folder, pushes written to a file, no Discord.
# Copy this file to <repo>/.dev/callapi.env (git-ignored), fill in the LiveKit key, then from call-backend/:
#     npm run dev
# which is the same as:   DOTENV_CONFIG_PATH=../.dev/callapi.env node src/server.js
# NEVER start a dev copy with call-backend/.env – on the dev PC that file is the production one, with the real
# Discord token: a test call would message the parents.
PORT=3100
ADMIN_PORT=3101
ADMIN_PASSWORD=dev
DEVICE_KEY=dev-key
DATA_DIR=../.dev/callapi-data
PUSH_TRANSPORT=file
CALL_PUBLIC_URL=http://127.0.0.1:3100

# Empty on purpose: the dev copy can never message anyone. The user ids only have to be there.
DISCORD_BOT_TOKEN=
DISCORD_MOR_USER_ID=1
DISCORD_FAR_USER_ID=2

# Calls use the real LiveKit server (each call gets a room of its own). Fill in the pair from call-backend/.env.
LIVEKIT_URL=wss://rtc.noobventure.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
